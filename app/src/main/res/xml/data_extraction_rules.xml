<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="notifications.db" />
        <exclude domain="database" path="notifications.db-wal" />
        <exclude domain="database" path="notifications.db-shm" />
        <exclude domain="database" path="unifiedpush-connector" />
        <exclude domain="database" path="unifiedpush-connector.db" />
        <exclude domain="database" path="unifiedpush-connector.db-wal" />
        <exclude domain="database" path="unifiedpush-connector.db-shm" />
        <exclude domain="file" path="accounts" />
        <exclude domain="file" path="notifications" />
        <exclude domain="sharedpref" path="notification_launch.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="notifications.db" />
        <exclude domain="database" path="notifications.db-wal" />
        <exclude domain="database" path="notifications.db-shm" />
        <exclude domain="database" path="unifiedpush-connector" />
        <exclude domain="database" path="unifiedpush-connector.db" />
        <exclude domain="database" path="unifiedpush-connector.db-wal" />
        <exclude domain="database" path="unifiedpush-connector.db-shm" />
        <exclude domain="file" path="accounts" />
        <exclude domain="file" path="notifications" />
        <exclude domain="sharedpref" path="notification_launch.xml" />
    </device-transfer>
</data-extraction-rules>
